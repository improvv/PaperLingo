{
  "name": "paper-lingo",
  "version": "1.0.0",
  "private": true,
  "description": "A personal PDF research paper reader with instant English-to-Korean translation.",
  "scripts": {
    "postinstall": "node scripts/copy-pdf-assets.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "PAPERLINGO_LIVE=1 playwright test tests/e2e/live.spec.ts"
  },
  "dependencies": {
    "he": "^1.2.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-pdf": "^10.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/he": "^1.2.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module"
}
